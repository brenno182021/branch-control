# Copie para config/database.properties e preencha. O arquivo real NÃO deve ir para o Git.
# Também é possível informar estas chaves como variáveis de ambiente (elas têm prioridade).
DB_URL=jdbc:postgresql://127.0.0.1:5432/branch_control
DB_USER=branch_control
DB_PASSWORD=ALTERE_PARA_A_SENHA_DO_USUARIO_DO_BANCO
# Use barras / em paths Windows; clone os repositórios dentro desta pasta.
BRANCH_CONTROL_WORKSPACE=./workspace
# Apenas para migrar uma instalação antiga; faça backup e use um banco vazio.
BRANCH_CONTROL_IMPORT_LEGACY=false
BRANCH_CONTROL_LEGACY_DIRECTORY=./data
